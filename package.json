{
  "name": "anchor-media-automate",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev": "pnpm -r --parallel --filter @ama/api --filter @ama/web dev",
    "dev:api": "pnpm --filter @ama/api dev",
    "dev:web": "pnpm --filter @ama/web dev",
    "deploy:api": "pnpm --filter @ama/api cf:deploy",
    "deploy:web": "pnpm --filter @ama/web cf:deploy",
    "deploy": "pnpm deploy:api && pnpm deploy:web",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  }
}
