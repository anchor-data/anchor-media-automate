{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anchor-media-api",
  "main": "src/index.ts",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "anchor-media.anchor-ltd.tech/api/*",
      "zone_name": "anchor-ltd.tech"
    }
  ],
  "compatibility_date": "2026-10-11",
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [
    {
      "binding": "REFERENCE_FILES",
      "bucket_name": "anchor-media-reference-files"
    },
    {
      "binding": "IMAGE_ASSETS",
      "bucket_name": "anchor-media-image-assets"
    }
  ],
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "vars": {
    "ALLOWED_ORIGIN": "https://anchor-media.anchor-ltd.tech"
  }
}
