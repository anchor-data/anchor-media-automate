{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ama-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "AGENT_MODE": "mock",
    "TURSO_DATABASE_URL": "",
    "TURSO_AUTH_TOKEN": "",
    "OPENAI_API_KEY": "",
    "CANVA_CLIENT_ID": "",
    "CANVA_CLIENT_SECRET": "",
    "INSTAGRAM_ACCESS_TOKEN": "",
    "ALLOWED_ORIGIN": "*"
  }
}
